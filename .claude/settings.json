{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "permissions": {
    "allow": ["TaskCreate", "TaskList"]
  },
  "sandbox": {
    "network": {
      "allowedDomains": ["github.com", "api.github.com", "*.githubusercontent.com"]
    },
    "excludedCommands": ["gh *", "git push *", "git fetch *", "git checkout *", "git switch *"]
  }
}
